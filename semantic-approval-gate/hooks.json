{
  "semantic-approval-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/semantic_approver.py",
            "timeout": 25
          }
        ]
      }
    ]
  }
}
